# ────────────────────────────────────────────────────────────────────────────
# Halo Ring · 环意 — .gitignore
# ────────────────────────────────────────────────────────────────────────────

# ───────── Gradle / Android build artefacts ──────────────────────────────────
**/build/
**/.gradle/
**/.cxx/
**/captures/

# Build outputs / signed APKs
**/outputs/
*.apk
*.aab
*.dex.jar


# ───────── IDE / editor metadata ─────────────────────────────────────────────
.idea/
*.iml
.vscode/
.fleet/
.DS_Store
Thumbs.db


# ───────── Local environment + secrets ───────────────────────────────────────
# Absolute paths and SDK locations — different per developer machine.
**/local.properties

# Signing config — never commit.
*.keystore
*.jks
keystore.properties


# ───────── Vendor SDK ────────────────────────────────────────────────────────
# The RayNeo Mercury SDK AAR (`mercury-release.aar`) is committed directly under
# `app-project/app/libs/` — it's the openly-distributable RayNeo ARDK, not
# proprietary. CI builds pick it up unchanged. See `app-project/app/libs/README.md`.
# (Previous revisions of this file blocked `*.aar` from tracking; audit-2026-05-13m.)


# ───────── Build tool caches ─────────────────────────────────────────────────
**/.kotlin/
**/.cache/
**/.tmp/
.kotlin-js-store/


# ───────── Python bytecode (phase0 probe) ────────────────────────────────────
__pycache__/
*.pyc
phase0/.venv/


# ───────── Profiling / debug ─────────────────────────────────────────────────
*.hprof
*.log
*.tmp


# ───────── Misc dev artefacts ────────────────────────────────────────────────
*.swp
*~
.envrc


# ───────── Private dev workspace only (no-op in the OSS mirror) ──────────────
# Third-party reference repos live under `research/` as their own git clones — each has its
# own remote, mirroring them here would duplicate. See `refs/README.md` §6 for re-clone recipe.
research/

# Claude per-project local settings (memory lives outside the repo, in ~/.claude/projects/).
.claude/

    <string name="tour_phantom_triple_after">Profile: Navigation → Media</string>
    <string name="tour_phantom_leave_after">system launcher</string>
    <string name="tour_phantom_inside">inside…</string>
    <string name="tour_phantom_detail_content">(detail content)</string>
    <string name="tour_phantom_all_set">All set</string>

    <!-- ════════════════════════════════════════════════════════════════════════
         First-run wizard.
         ════════════════════════════════════════════════════════════════════════ -->
    <string name="wizard_step_count">Step %1$d of %2$d</string>

    <string name="wizard_welcome_title">Welcome to Halo Ring</string>
    <string name="wizard_welcome_body">Setup takes about a minute. We\'ll enable wireless ADB, accessibility, battery exemption, then pair your ring.</string>
    <string name="wizard_welcome_cta">START</string>

    <string name="wizard_adb_title">Enable wireless ADB</string>
    <string name="wizard_adb_body">We need a brief 6-digit pairing so the app can push the injection agent. After this you never see this step again.</string>
    <string name="wizard_adb_cta_start">START PAIRING</string>
    <string name="wizard_adb_cta_open_settings">OPEN DEVELOPER OPTIONS</string>

    <string name="wizard_a11y_title">Accessibility (optional)</string>
    <string name="wizard_a11y_body">Lets the back / home / recents controls work without ADB. Skippable; the agent does the same things.</string>
    <string name="wizard_a11y_cta_enable">OPEN ACCESSIBILITY SETTINGS</string>
    <string name="wizard_a11y_enabled">✓ Enabled</string>

    <string name="wizard_battery_title">Battery exemption</string>
    <string name="wizard_battery_body">Stops Android Doze from killing the background service after a few hours of inactivity.</string>
    <string name="wizard_battery_cta">REQUEST EXEMPTION</string>
    <string name="wizard_battery_exempted">✓ Exempt</string>

    <string name="wizard_pair_title">Pair the ring</string>
    <string name="wizard_pair_body">Take the ring off any charger. The app will scan for nearby Halo / R08 rings. Confirm the MAC + LED double-flash.</string>
    <string name="wizard_pair_cta">SCAN FOR RING</string>
    <string name="wizard_ring_reconnect_title">Reconnect the ring</string>
    <string name="wizard_ring_reconnect_progress">Reconnecting to your paired ring…</string>
    <string name="wizard_ring_reconnect_timeout">Ring didn\'t reconnect in time. It may just be out of range or asleep — tap to try again.</string>
    <string name="wizard_ring_reconnect_retry_cta">RECONNECT RING</string>

    <string name="wizard_complete_cta">FINISH</string>

    <!-- First-run wizard: short variants used by the on-glasses layout. -->
    <string name="wizard_welcome_begin_cta">BEGIN</string>
    <string name="wizard_adb_intro_title">System access</string>
    <string name="wizard_adb_intro_body">To let the ring drive the glasses, grant one-time system access — all on-device, no computer:\n1. Enable Wireless Debugging (steps below)\n2. Enable Halo Ring in Settings → Accessibility (required once)\n3. Tap START PAIRING — open \"Pair device with pairing code\"\n4. Enter the 6-digit code in the panel that appears\nThis survives reboot — you only do it once.</string>
    <string name="wizard_adb_open_settings_cta">OPEN WIRELESS DEBUGGING</string>
    <string name="wizard_adb_start_pairing_cta">START PAIRING</string>
    <!-- Step indicator + keep-alive step (v0.4 on-device setup). -->
    <string name="wizard_sys_step">System access</string>
    <string name="wizard_sys_devopts_label">Developer Options</string>
    <string name="wizard_sys_wifi_label">Wi-Fi</string>
    <string name="wizard_sys_wireless_label">Wireless Debugging</string>
    <string name="wizard_sys_enable_devopts_cta">ENABLE DEVELOPER OPTIONS</string>
    <!-- Wi-Fi gate page (shown between Developer Options and Wireless Debugging). -->
    <string name="wizard_wifi_title">Enable Wi-Fi</string>
    <string name="wizard_wifi_body">Wireless ADB needs the Wi-Fi radio on to bind its port. No internet connection required — just the switch. Once the agent is paired, Wi-Fi can be turned off.</string>
    <string name="wizard_wifi_cta">OPEN WI-FI SETTINGS</string>
    <string name="wizard_wifi_off_title">Turn Wi-Fi off</string>
    <string name="wizard_wifi_off_body">Setup is done. Control now runs over a local channel — Wi-Fi is no longer needed. Turn it off now; the ring keeps working with Wi-Fi off, away from any network, and across reboots.</string>
    <string name="wizard_wifi_off_cta">TURN OFF WI-FI</string>
    <string name="wizard_wifi_off_done">Confirmed — working with Wi-Fi off</string>
    <string name="wizard_wifi_off_agent_lost">Control dropped when Wi-Fi turned off. Turn Wi-Fi back on and re-run setup.</string>
    <!-- Accessibility gate — shown before any other system-access gate. -->
    <string name="wizard_a11y_gate_body">Enable \"Halo Ring\" in Accessibility settings first — the pairing code panel runs through this service.</string>
    <string name="wizard_keepalive_step">Keep-alive</string>
    <string name="wizard_pair_step">Pair ring</string>
    <string name="wizard_keepalive_title">Keep it alive</string>
    <string name="wizard_keepalive_body">So the ring keeps working in the background and after a reboot, enable both:</string>
    <string name="wizard_keepalive_battery_row">Battery: ignore optimisation</string>
    <string name="wizard_keepalive_battery_desc">Stops Android Doze from killing the service.</string>
    <string name="wizard_keepalive_autostart_row">Background: unrestricted</string>
    <string name="wizard_keepalive_autostart_desc">In App info → Battery, set to \"Unrestricted\". Restart-after-reboot is already automatic (boot receiver). Some ROMs also have a separate \"Auto-start\" toggle — enable it here if present.</string>
    <string name="wizard_keepalive_autostart_cta">OPEN APP INFO</string>
    <string name="wizard_keepalive_battery_cta">ALLOW BATTERY</string>
    <string name="wizard_keepalive_done_cta">CONTINUE</string>
    <string name="wizard_done_cta">FINISH</string>
    <string name="wizard_adb_running_title">Pairing…</string>
    <string name="wizard_adb_paired_title">Paired</string>
    <string name="wizard_adb_continue_cta">CONTINUE</string>
    <string name="wizard_adb_failed_title">Pairing failed</string>
    <string name="wizard_adb_try_again_cta">TRY AGAIN</string>
    <string name="wizard_adb_reconnect_cta">RECONNECT AGENT</string>
    <string name="wizard_adb_reconnecting_title">Reconnecting…</string>
    <string name="wizard_a11y_on_title">Accessibility on</string>
    <string name="wizard_a11y_on_body">Auto-switch by foreground app is active.</string>
    <string name="wizard_a11y_off_title">Accessibility</string>
    <string name="wizard_a11y_off_body">Optional. Powers auto-switch by foreground app.</string>
    <string name="wizard_battery_on_title">Battery free</string>
    <string name="wizard_battery_on_body">Doze won\'t kill the BLE link.</string>
    <string name="wizard_battery_off_title">Battery</string>
    <string name="wizard_battery_off_body">Allow background so Doze can\'t kill the BLE link.</string>
    <string name="wizard_battery_allow_cta">ALLOW</string>
    <string name="wizard_pair_short_title">Pair ring</string>
    <string name="wizard_pair_short_body">Wear the ring (not the cradle). Two blinks = paired.</string>
    <string name="wizard_pair_scan_cta">SCAN</string>
    <string name="wizard_pair_done_cta">DONE</string>


    <!-- ════════════════════════════════════════════════════════════════════════
         Guided tour.
         ════════════════════════════════════════════════════════════════════════ -->
    <string name="tour_step_counter">%1$d / %2$d</string>
    <string name="tour_got_it">Got it!</string>
    <string name="tour_wrong_gesture">That was %1$s — try the one shown above</string>
    <string name="tour_no_ring_hint">(No ring connected — tap NEXT to keep watching.)</string>

    <string name="tour_welcome_title">Welcome</string>
    <string name="tour_welcome_ring">Quick tour of how to operate the app. Tap NEXT to start.</string>
    <string name="tour_welcome_temple">Quick tour. Tap NEXT to start.</string>

    <string name="tour_move_down_title">Move cursor down</string>
    <string name="tour_move_down_ring">Swipe DOWN on your ring → cursor moves to the next row.</string>
    <string name="tour_move_down_temple">Slide FORWARD on the temple touchpad.</string>

    <string name="tour_move_up_title">Move cursor up</string>
    <string name="tour_move_up_ring">Swipe UP on your ring → cursor moves to the previous row.</string>
    <string name="tour_move_up_temple">Slide BACKWARD on the temple touchpad.</string>

    <string name="tour_enter_row_title">Enter the focused row</string>
    <string name="tour_enter_row_ring">Tap once on the ring → opens whatever is currently focused.</string>
    <string name="tour_enter_row_temple">Single-click the temple touchpad.</string>

    <string name="tour_back_title">Go back</string>
    <string name="tour_back_ring">Double-tap to return to the previous screen.</string>
    <string name="tour_back_temple">Double-click the temple touchpad.</string>

    <string name="tour_tab_focus_title">Focus the top tabs</string>
    <string name="tour_tab_focus_ring">When the cursor\'s on the top row, one more SWIPE UP moves focus onto the tab strip.</string>
    <string name="tour_tab_focus_temple">On the top row, slide BACKWARD again to jump up to the tab strip.</string>

    <string name="tour_tab_cycle_title">Cycle tabs</string>
    <string name="tour_tab_cycle_ring">With tabs focused, SWIPE UP / DOWN cycles VITALS ⇄ SETTINGS ⇄ STATUS.</string>
    <string name="tour_tab_cycle_temple">Slide FORWARD / BACKWARD on the temple to cycle.</string>

    <string name="tour_enter_tab_title">Enter the chosen tab</string>
    <string name="tour_enter_tab_ring">TAP once to drop focus from the tab strip back into the tab\'s first content row.</string>
    <string name="tour_enter_tab_temple">Single-CLICK the temple to enter the tab.</string>

    <string name="tour_long_press_title">Long press — menu / wake</string>
    <string name="tour_long_press_ring">Press and hold the ring. Opens menu; wakes the glasses when the screen is off.</string>
    <string name="tour_long_press_temple">Long-press the temple touchpad.</string>

    <string name="tour_triple_title">Triple tap — switch profile</string>
    <string name="tour_triple_ring">Tap three times to cycle profile (Navigation → Media → Reader → Fast).</string>
    <string name="tour_triple_temple">Triple-click the temple touchpad.</string>

    <string name="tour_leave_title">Leave the app</string>
    <string name="tour_leave_ring">DOUBLE-TAP at the root drops back to the system launcher.</string>
    <string name="tour_leave_temple">Double-click the temple at the root to leave the app.</string>

    <string name="tour_done_title">You\'re ready</string>
    <string name="tour_done_body">Practise any time at Settings → Test Arena. Re-open this tour at Settings → About.</string>

    <string name="tour_phantom_long_press_before">hold and wait</string>
    <string name="tour_phantom_long_press_after">menu opens (or screen wakes)</string>

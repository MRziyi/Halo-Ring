<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar notification icon for Halo Ring.
  Android auto-tints monochrome silhouettes white in the status bar — so we draw a single
  white annulus on a transparent background. Stroke = single closed ring shape, 24 dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?android:attr/colorControlNormal">
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M 12,2.5
                          a 9.5,9.5 0 1 0 0,19
                          a 9.5,9.5 0 1 0 0,-19 Z
                          M 12,5.5
                          a 6.5,6.5 0 1 1 0,13
                          a 6.5,6.5 0 1 1 0,-13 Z"/>
</vector>

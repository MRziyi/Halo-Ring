<?xml version="1.0" encoding="utf-8"?>
<!--
  AccessibilityService config.
  - WINDOW_STATE_CHANGED / WINDOWS_CHANGED: read the foreground package (ModeManager auto-switch)
    and drive the Bluetooth "Internet access" re-enable UI flow (see HaloRingAccessibilityService).
  - canRetrieveWindowContent: needed so that flow can find + click the "Internet access" toggle in
    the system Settings UI (Android resets that toggle on every reboot; we re-apply it).
  - global actions (Back/Home/Recents/Notifications) for AccessibilityBackend without ADB.
  - canPerformGestures: FALSE here (Rokid + base) — Rokid injects via the agent, a11y does global
    actions only. The **rayneo** flavor overrides this file (src/rayneo/res/xml/) with
    canPerformGestures="true" because dispatchGesture is its primary tap/swipe nav path. Keeping the
    base false means Rokid behaviour is unchanged.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowsChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows|flagReportViewIds"
    android:canPerformGestures="false"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="100"
    android:summary="Lets Halo Ring do Back/Home/Recents without ADB, auto-switch profiles by foreground app, and re-enable Bluetooth internet sharing after a reboot." />

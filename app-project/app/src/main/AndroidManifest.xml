<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- BLE central role -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <!-- Pre-Android-12 BLE scan needs location. Both must be declared together. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- AdbMdnsDiscovery uses Android NsdManager → mDNS over loopback → requires INTERNET.
         (No actual outbound network — the daemon is local. NsdManager.create() still throws
         SecurityException without this permission on Android 14+.) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Resident foreground service for the BLE central + ring lifecycle -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Granted by `pm grant ...` via the ADB-bootstrap wizard; lets us toggle wireless debugging -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Used by HudOverlay (gesture-recognised pills) AND the pairing-code overlay that lets us
         show a text input on top of the system Wireless-debugging pairing dialog. Without this,
         the user has to memorise the 6-digit code and switch apps, which closes the system
         dialog and tears down the mDNS advertisement before we can find it. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- BLE is functionally required, but we leave it as "not required" to keep the same APK
         installable on the GENERIC_ANDROID dev fallback (e.g. an emulator without a BLE stack).
         The runtime guards in AndroidR08BleClient.start() degrade gracefully when adapter==null. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <!-- We surface the LEANBACK_LAUNCHER category so Rokid Sprite Launcher's big-icon grid picks
         us up. We are NOT an Android TV app, so explicitly mark TV-only features optional. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:name=".HaloRingApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.HaloRing"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        tools:ignore="MissingTvBanner"><!-- not deploying to Android TV; the LEANBACK_LAUNCHER intent is there to look right in Rokid Sprite Launcher's big-icon grid -->

        <!-- P2-13: configChanges keeps MainActivity alive across rotation / fontScale / locale /
             uiMode / density changes. The HUD overlay (in HaloRingService) is unaffected by
             config changes anyway, but having the Activity recreate every time the user opens a
             system Settings deep-link from Advanced screen would (a) lose the navStack and (b)
             flash the splash. AppCompatDelegate.setApplicationLocales (audit-2026-05-13s) handles
             locale-change recreation explicitly when needed. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.HaloRing.Splash"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|fontScale|uiMode|density|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Both Rokid (Sprite) and RayNeo launchers honour LEANBACK_LAUNCHER for big-icon TV-style grids -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.HaloRingService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- P2-12: exported=false. All three actions (BOOT_COMPLETED / LOCKED_BOOT_COMPLETED /
             MY_PACKAGE_REPLACED) are protected broadcasts — only the system can send them, and
             the system delivers them regardless of exported state. Exporting buys nothing here
             and lets a hostile app discover our receiver via PackageManager. -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Debug-only `PairingTestReceiver` is declared ONLY in `app/src/debug/AndroidManifest.xml`
             — never merged into release builds. (Previously this lived here with `tools:node="merge"`,
             which is a no-op + accidentally exported the receiver in release APKs. Audit-2026-05-13k.) -->

        <!-- AccessibilityService is OPTIONAL: enables foreground-package auto-switch + Back/Home
             fallback. The app works without it (ADB agent does everything), but enabling it lets us
             reduce the cases where we need the ADB connection alive. -->
        <service
            android:name=".accessibility.HaloRingAccessibilityService"
            android:exported="false"
            android:label="@string/a11y_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/halo_ring_accessibility_config" />
        </service>
    </application>
</manifest>

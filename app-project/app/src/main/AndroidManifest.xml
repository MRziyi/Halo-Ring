<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- BLE central role -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <!-- Pre-Android-12 BLE scan needs location. Both must be declared together. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- AdbMdnsDiscovery uses Android NsdManager → mDNS over loopback → requires INTERNET.
         (No actual outbound network — the daemon is local. NsdManager.create() still throws
         SecurityException without this permission on Android 14+.) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ACCESS_NETWORK_STATE: ConnectivityManager (network type checks). Normal permission. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- ACCESS_WIFI_STATE: WifiManager.isWifiEnabled() — used by the wizard's Wi-Fi gate
         (wireless ADB needs the Wi-Fi interface on; internet connectivity not required). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- CHANGE_WIFI_STATE: WifiManager.setWifiEnabled() — best-effort auto-enable Wi-Fi at
         boot so bootRecoverAgent can restart the agent without user interaction.
         Deprecated on Android 10+ for third-party apps but may work on OEM builds (Rokid). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Resident foreground service for the BLE central + ring lifecycle -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Granted by `pm grant ...` via the ADB-bootstrap wizard; lets us toggle wireless debugging -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Used by HudOverlay (gesture-recognised pills) AND the pairing-code overlay that lets us
         show a text input on top of the system Wireless-debugging pairing dialog. Without this,
         the user has to memorise the 6-digit code and switch apps, which closes the system
         dialog and tears down the mDNS advertisement before we can find it. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- ──────────────────────────────────────────────────────────────────────────────────────
         Doc/18 — Halo Ring External-App Plugin Protocol v1.
         Three permissions: we declare them all (we're the owner) and `uses-permission` the two
         that we need to consume ourselves. External plugin apps reference these by name in their
         own manifests; the system enforces the matching protectionLevel.
         ────────────────────────────────────────────────────────────────────────────────────── -->

    <permission
        android:name="com.halo.ring.permission.READ_PLUGIN_ACTIONS"
        android:protectionLevel="signature"
        android:label="@string/perm_read_plugin_actions_label"
        android:description="@string/perm_read_plugin_actions_desc" />
    <!-- Plugin apps put this on their ContentProvider's `readPermission`. Halo Ring uses the
         permission to query them. Signature level → only WE can hold it (it's our own
         permission, defined with our app's signing cert). On a stock device only one app per
         signing cert exists, so this is effectively self-permission. -->
    <uses-permission android:name="com.halo.ring.permission.READ_PLUGIN_ACTIONS" />

    <permission
        android:name="com.halo.ring.permission.SEND_PLUGIN_TRIGGER"
        android:protectionLevel="normal"
        android:label="@string/perm_send_plugin_trigger_label"
        android:description="@string/perm_send_plugin_trigger_desc" />
    <!-- Plugin apps put this on their TRIGGER BroadcastReceiver. We hold it implicitly because
         we declared it; the system rejects any other app's sendBroadcast(...) of our action
         unless it has this permission. (Normal level — the trigger itself is not security-
         sensitive; this just prevents random apps from spoofing triggers to plugins.) -->

    <permission
        android:name="com.halo.ring.permission.PUSH_PROFILE"
        android:protectionLevel="signature|privileged"
        android:label="@string/perm_push_profile_label"
        android:description="@string/perm_push_profile_desc" />
    <!-- External overlay apps that want to push HUD profiles declare uses-permission for this.
         Signature|privileged — same-cert-signed plugins (rare; the wearer manually installs
         them) and OEM-bundled privileged plugins. Not granted to random installs.
         Halo Ring does NOT uses-permission this one — we're the receiver, not the sender. -->

    <!-- ──────────────────────────────────────────────────────────────────────────────────────
         Package visibility for Doc/18 plugin discovery.
         On Android 11+ (targetSdk 30+), PackageManager queries only return packages our app
         is "visible" to. Plugins declare a BroadcastReceiver for our TRIGGER action; declaring
         visibility for that intent surfaces them — all of a visible package's components
         (Activity / Service / ContentProvider) become reachable, so PluginQuery can hit each
         plugin's `content://{pkg}.halo_actions/list` provider without additional declarations.
         ────────────────────────────────────────────────────────────────────────────────────── -->
    <queries>
        <intent>
            <action android:name="com.halo.ring.action.TRIGGER" />
        </intent>
    </queries>

    <!-- BLE is functionally required, but we leave it as "not required" to keep the same APK
         installable on the GENERIC_ANDROID dev fallback (e.g. an emulator without a BLE stack).
         The runtime guards in AndroidR08BleClient.start() degrade gracefully when adapter==null. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <!-- We surface the LEANBACK_LAUNCHER category so Rokid Sprite Launcher's big-icon grid picks
         us up. We are NOT an Android TV app, so explicitly mark TV-only features optional. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:name=".HaloRingApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.HaloRing"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        tools:ignore="MissingTvBanner"><!-- not deploying to Android TV; the LEANBACK_LAUNCHER intent is there to look right in Rokid Sprite Launcher's big-icon grid -->

        <!-- P2-13: configChanges keeps MainActivity alive across rotation / fontScale / locale /
             uiMode / density changes. The HUD overlay (in HaloRingService) is unaffected by
             config changes anyway, but having the Activity recreate every time the user opens a
             system Settings deep-link from Advanced screen would (a) lose the navStack and (b)
             flash the splash. AppCompatDelegate.setApplicationLocales (audit-2026-05-13s) handles
             locale-change recreation explicitly when needed. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.HaloRing.Splash"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|fontScale|uiMode|density|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Both Rokid (Sprite) and RayNeo launchers honour LEANBACK_LAUNCHER for big-icon TV-style grids -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.HaloRingService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- P2-12: exported=false. All three actions (BOOT_COMPLETED / LOCKED_BOOT_COMPLETED /
             MY_PACKAGE_REPLACED) are protected broadcasts — only the system can send them, and
             the system delivers them regardless of exported state. Exporting buys nothing here
             and lets a hostile app discover our receiver via PackageManager. -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Debug-only `PairingTestReceiver` is declared ONLY in `app/src/debug/AndroidManifest.xml`
             — never merged into release builds. (Previously this lived here with `tools:node="merge"`,
             which is a no-op + accidentally exported the receiver in release APKs. Audit-2026-05-13k.) -->

        <!-- AccessibilityService is OPTIONAL: enables foreground-package auto-switch + Back/Home
             fallback. The app works without it (ADB agent does everything), but enabling it lets us
             reduce the cases where we need the ADB connection alive. -->
        <service
            android:name=".accessibility.HaloRingAccessibilityService"
            android:exported="false"
            android:label="@string/a11y_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/halo_ring_accessibility_config" />
        </service>
    </application>
</manifest>
